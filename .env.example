# Copiar como .env y ajustar. El .env no se versiona.
# Servidor MLflow del equipo; si no responde, `make mlflow-local` y usar http://127.0.0.1:5000
MLFLOW_TRACKING_URI=https://mlflow.equipo7mlops.com

# Docker Compose (opcionales; sin definirlas se usan los valores por defecto del docker-compose.yml).
# MLFLOW_TRACKING_URI de arriba solo lo usa el servicio `api` del perfil `servidor`; el sistema
# completo (`docker compose up`) siempre lee los modelos del MLflow local (http://mlflow:5000).
# Servidor del que el sembrador copia los modelos champion al MLflow local
# MLFLOW_ORIGEN_URI=https://mlflow.equipo7mlops.com
# Alias que se siembra y se sirve (por ejemplo, challenger)
# MODELO_ALIAS=champion
# Puerto del MLflow local en la máquina (en macOS el 5000 suele estar ocupado por AirPlay: usar 5001)
# MLFLOW_PUERTO=5000
# Puerto de la API del perfil `servidor` (la del sistema completo usa el 8000)
# API_SERVIDOR_PUERTO=8001
